# 控制台登录 / Session
SESSION_SECRET=change_me_to_a_random_secret

# 数据库敏感字段对称加密密钥（Fernet / urlsafe base64）
# 生成: python -c "from src.db.crypto import generate_key; print(generate_key())"
# 未配置时 Run.password / Run.card_key / MailAccount.client_id / MailAccount.refresh_token 以明文落盘，仅限 dev/test。
DB_ENCRYPTION_KEY=
ADMIN_USERNAME=admin
ADMIN_PASSWORD=admin123456
OPERATOR_USERNAME=
OPERATOR_PASSWORD=
VIEWER_USERNAME=
VIEWER_PASSWORD=

# AdsPower 本地 API
ADS_API=http://local.adspower.net:50325
ADS_API_KEY=your_ads_api_key

# Efuncard 虚拟信用卡
EFUNCARD_TOKEN=your_efuncard_token

# 虚拟卡 provider 选择: efuncard / nodecard / x988card
CARD_PROVIDER=efuncard

# X988Card (cards.779.chat / card.988.chat) 虚拟卡
# 使用方式: CARD_PROVIDER=x988card 后用任务 card_key 字段传卡密
X988CARD_API_BASE=https://cards.779.chat
X988CARD_REQUEST_TIMEOUT=15

# SMS-Activate 接码平台
SMS_API_KEY=your_sms_api_key
SMS_COUNTRY=6

# 邮件服务配置（通过 HTTP API 对接 email-provider）
EMAIL_PROVIDER_BASE_URL=http://127.0.0.1:8000
EMAIL_PROVIDER_API_KEY=replace-with-a-long-random-secret
EMAIL_PROVIDER_NAME=applemail
# 邮件 provider 子类开关（feat/mail-provider-classes 2026-05-24 引入）
# 启用后 MailManager 按邮箱域名自动路由：hotmail/outlook.com 走 Outlook，zhangxb.xyz/cloudsentryai.com 走 CFWorker
# 两个都开 → 按域名分发；都不命中 → fallback 到 EMAIL_PROVIDER_NAME 旧路径
OUTLOOK_ENABLED=false
OUTLOOK_CONFIG_NAME=outlook-pool-default
CFWORKER_ENABLED=false
CFWORKER_CONFIG_NAME=mydomain-cfworker
KNOWN_MAIL_ACCOUNTS_JSON=

# 以下为兼容字段：
# - MAIL_DOMAIN 仅保留旧脚本兼容
# - 推荐把 applemail / credentialed 邮箱写到 KNOWN_MAIL_ACCOUNTS_JSON
#   例如：
#   {"applemail":[{"email":"foo@example.com","client_id":"cid","refresh_token":"rt","password":"unused","preserve_existing_mail":true}]}
# - 当未配置 JSON，或当前任务邮箱未命中 JSON 且仍保留单邮箱兼容凭据时，
#   会退回 MAIL_REFRESH_TOKEN + MAIL_CLIENT_ID
MAIL_DOMAIN=
MAIL_REFRESH_TOKEN=
MAIL_CLIENT_ID=

# 可选代理（如 socks5h://127.0.0.1:7890）
PROXY=
DEFAULT_BROWSER_PROVIDER=browser-default
DEFAULT_CARD_PROVIDER=card-default
DEFAULT_MAIL_PROVIDER=mail-default
DEFAULT_MAIL_ACCOUNT_ID=

# 受限 LLM 决策器（OpenAI 兼容）
LLM_ENABLED=false
LLM_BASE_URL=
LLM_API_KEY=
LLM_MODEL=
LLM_TIMEOUT_MS=8000
LLM_CONFIDENCE_THRESHOLD=0.6
LLM_MAX_CONSECUTIVE_UNCERTAIN=2

# 卡住诊断器（Vision LLM，BLOCKED / ERROR / 重试超限时判断"卡在哪/为什么/建议怎么改"）
# 与 LLM_* 的区别：分诊器只归因不选 action（incident-level vs action-level）。
# 两类诊断结论：
#   风控类（外部原因）：ip_pollution / card_declined / captcha / account_banned / rate_limited
#   工程类（代码原因，给开发者整改建议）：selector_stale（选择器失效）/ handler_stuck（逻辑卡死）
#                                          / dom_drift（页面漂移）—— 会附 fix_suggestion
# 输出去向：① RunEvent 事件流（前端 /tasks 详情页渲染诊断卡片）
#           ② artifacts/runs/{run_id}/triage.jsonl 落盘
#           ③ 失败终态 error_reason 拼 [triage=<category>] 便于 /accounts 聚合
# 默认关闭（零成本）；仅在卡住那一刻触发一次，不是每步都调。
TRIAGE_ENABLED=false
TRIAGE_BASE_URL=
TRIAGE_API_KEY=
TRIAGE_MODEL=
TRIAGE_TIMEOUT_MS=15000
TRIAGE_CONFIDENCE_THRESHOLD=0.6

# Captcha solver（Turnstile 自愈，详见 src/automation/captcha_solver.py）
# CAPTCHA_SOLVER_KIND: noop（默认零行为）/ manual（强制人工接管）/ nocaptcha（调 nocaptcha.io）
# OpenAI 注册用 Cloudflare Turnstile（不是 hCaptcha），仅 nocaptcha 后端有效
# 启用前必须先在 dev 跑通；预算护栏 BUDGET_CAP_USD 超支后建议运维改回 noop
CAPTCHA_SOLVER_KIND=noop
NOCAPTCHA_USER_TOKEN=
CAPTCHA_SOLVER_BUDGET_CAP_USD=5.0
CAPTCHA_SOLVER_TIMEOUT_MS=30000

# Sentinel PoW 配置（详见 src/automation/sentinel.py）
# OpenAI 2025+ 在敏感端点（注册/登录/OTP/payment_link/promo）强制要求 openai-sentinel-token header
# SENTINEL_STRATEGY: noop（默认零行为）/ pure_python（本地 FNV-1a brute-force + curl_cffi 拿挑战）
# 启用前需在 dev 跑通；SDK 版本号变化时同步更新 SENTINEL_SDK_VERSION
SENTINEL_STRATEGY=noop
SENTINEL_SDK_VERSION=20260124ceb8
SENTINEL_IMPERSONATE=chrome120
SENTINEL_TIMEOUT_MS=10000

# 上场前体检（Preflight）：卡 BIN / 代理 IP / SMS / 账单国家一致性 + 浏览器指纹评分
# PREFLIGHT_MODE: off（跳过）/ warn（只记事件，默认）/ block（发现问题立即中止任务）
PREFLIGHT_MODE=warn
FINGERPRINT_MIN_SCORE=80

# 自动化运行时开关
# ENABLE_PAYMENT_FLOW=true: 注册成功后允许进入支付阶段
# PAYMENT_PLAN=team: 使用 Team 免费试用计划
# PAYMENT_LINK_ONLY=true: 只生成支付链接，不执行绑卡/支付页自动化
# PAYMENT_LINK_RETURN_MODE=long: 优先返回 pay.openai.com 的 hosted 长链接
# AIMIZY_COUNTRY / AIMIZY_CURRENCY: Team 免费试用长链接生成参数
# BILLING_*: 支付页账单资料，提交前会回读校验，避免 autofill 覆盖
ENABLE_PAYMENT_FLOW=true

# 卡预热（Pro 账号代刷模式）：用 mail_accounts 表里 extra.role="pro_warmup" 的账号登录 OpenAI，
# 用待绑卡触发 Pro Plan $200/$100 订阅 → 卡余额不足 → insufficient_funds decline →
# Stripe 给该卡积累活跃信号 → 回到新账号绑 Team trial $1 提升通过率
# Pro 账号的密码存在 mail_accounts.extra JSON 的 'password' 字段
# ENABLE_CARD_WARMUP=true 才会启用此流程
ENABLE_CARD_WARMUP=false
WARMUP_PRO_ATTEMPT_AMOUNTS=200,100
WARMUP_PRO_INTERVAL_HOURS=24

# 账号养号：注册成功后保持 free 状态 N 天 + 每天登录 + 3-10 条对话累积可信度后再绑 Team
ENABLE_ACCOUNT_WARMUP=false
WARMUP_MIN_DAYS=3
WARMUP_MAX_DAYS=7
WARMUP_MESSAGES_PER_DAY_MIN=3
WARMUP_MESSAGES_PER_DAY_MAX=10
WARMUP_CONVERSATION_TOPICS_PATH=
WARMUP_BLOCKED_THRESHOLD=2

PAYMENT_PLAN=team
PAYMENT_LINK_ONLY=true
PAYMENT_LINK_RETURN_MODE=long
AIMIZY_COUNTRY=SG
AIMIZY_CURRENCY=SGD

# checkout payload schema 版本（P4 模板化 2026-05-25）
# OpenAI 改 schema 时切版本：加 src/payment_link/schemas/<plan>_<version>.py + 改下面
# 单个模板可在 UI 填 schema_version 字段单点覆盖全局默认
# v2 = 2026-05 plan_name + is_coupon_from_query_param 顶层 + cancel_url=#pricing
# v1 = 当前 Team / Pro 的实现版本
PLUS_SCHEMA_VERSION=v2
TEAM_SCHEMA_VERSION=v1
PRO_SCHEMA_VERSION=v1
PRO_LITE_SCHEMA_VERSION=v1

BILLING_COUNTRY=US
BILLING_LINE1=350 5th Ave
BILLING_LINE2=
BILLING_CITY=New York
BILLING_STATE=NY
BILLING_POSTAL_CODE=10118
# 警告（2026-05-22）：所有号共用同一账单地址 → OpenAI ban 层聚类信号。
# 临时手动轮换池（来自 L 站 2026-05-22 帖子的"焚诀地址"，社区实测有效）：
#   1621 Elswick Lane,Charlotte,28214        (NC, ZIP 28214)
#   7714 Legacy Ln,Orlando,32818             (FL, ZIP 32818)
#   2922 E Le Marche Ave,Phoenix,85032       (AZ, ZIP 85032)
#   1586 29th Ave,San Francisco,94122        (CA, ZIP 94122)
#   2671 Clayton Oaks Dr,Dallas,75227        (TX, ZIP 75227)
# 长期方案：见 docs/research/openai-risk-control-timeline-2026-05.md §4.5 待补
# （需在 src/services/identity_generator.py 加地址生成 + 数据库持久化 + 注入点）
RUN_ARTIFACTS_DIR=artifacts/runs
TRACE_ON_FAILURE=true
CLEAN_CONTEXT_MODE=reuse_and_clean
MAX_NAVIGATION_RETRIES=2
MAX_EMAIL_ATTEMPTS=3
MAX_PROFILE_RECONNECTS=2
MAX_MANUAL_HANDOFFS=2

# 后台任务并发上限（范围 1-32，默认 2；超出范围会回退到默认并记录 warning）
MAX_WORKERS=2

# 人类行为模拟（贝塞尔鼠标轨迹 + 非匀速打字）。排障时可设 false 加速。
HUMANIZE_ENABLED=true

# 控制台单助手（当前默认使用本地知识库，可预留给后续远端增强）
ASSISTANT_ENABLED=true
ASSISTANT_DOC_PATH=docs/usage-manual.md
ASSISTANT_REQUIRE_COMMIT_CONFIRMATION=true

# 测试配置
TEST_EMAIL=your_test_email@outlook.com

# 业务流程自动化配置 (主流程测试用)
TASK_ADS_ID=your_ads_profile_id
TASK_CDK=your_cdk
TASK_EMAIL=your_signup_email@example.com
TASK_PASSWORD=your_signup_password
